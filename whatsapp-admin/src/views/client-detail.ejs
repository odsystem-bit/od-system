<%- include('partials/header', { page: 'clients', title: vendor.shop_name || vendor.name }) %>
<h1><%= vendor.shop_name || vendor.name %></h1>

<a href="/clients" class="btn" style="margin-bottom: 20px;">← Retour</a>

<div class="card">
  <h3>Informations boutique</h3>
  <p><strong>Nom:</strong> <%= vendor.name %></p>
  <p><strong>Boutique:</strong> <%= vendor.shop_name || '-' %></p>
  <p><strong>Téléphone:</strong> <%= vendor.phone_number %></p>
  <p><strong>Email:</strong> <%= vendor.email || '-' %></p>
  <p><strong>Type:</strong> <%= vendor.shop_type || '-' %></p>
  <p><strong>Site externe:</strong> <%= vendor.site_externe ? `<a href="${vendor.site_externe}" target="_blank" style="color: #00D4C8;">${vendor.site_externe}</a>` : '-' %></p>
  <p><strong>Short code:</strong> <%= vendor.short_code ? `<span class="badge badge-teal">${vendor.short_code}</span>` : '-' %></p>
  <p><strong>Lien WhatsApp Tracy:</strong> <%= vendor.short_code ? `wa.me/Tracy?text=${vendor.short_code}` : '-' %></p>
  <p><strong>Date création:</strong> <%= new Date(vendor.created_at).toLocaleDateString('fr-FR') %></p>
</div>

<div class="card">
  <h3>Abonnement actif</h3>
  <p><strong>Plan:</strong> 
    <% if (vendor.plan === 'gratuit') { %>
      <span class="badge badge-teal">Gratuit</span>
    <% } else if (vendor.plan === 'starter') { %>
      <span class="badge badge-orange">Starter</span>
    <% } else if (vendor.plan === 'standard') { %>
      <span class="badge badge-green">Standard</span>
    <% } else if (vendor.plan === 'pro') { %>
      <span class="badge badge-violet">Pro</span>
    <% } else { %>
      <span class="badge badge-red">-</span>
    <% } %>
  </p>
  
  <p style="margin-top: 16px;"><strong>Utilisation conversations:</strong></p>
  <% const percentage = vendor.conversations_included > 0 ? Math.round((vendor.conversations_count / vendor.conversations_included) * 100) : 0; %>
  <div style="background: #1a1a2e; height: 24px; border-radius: 8px; overflow: hidden; margin-top: 8px;">
    <div style="background: <%= percentage > 100 ? '#dc3545' : percentage > 80 ? '#ff9f40' : '#28a745' %>; height: 100%; width: <%= Math.min(percentage, 100) %>%; transition: width 0.3s;"></div>
  </div>
  <p style="margin-top: 8px; color: #888;"><%= vendor.conversations_count || 0 %> / <%= vendor.conversations_included === -1 ? '∞' : (vendor.conversations_included || '-') %> (<%= percentage %>%)</p>
  
  <p style="margin-top: 16px;"><strong>Surplus actuel:</strong> 
    <% if (vendor.surplus_count > 0) { %>
      <span style="color: #dc3545; font-weight: bold;"><%= vendor.surplus_count %> conversations (<%= vendor.surplus_amount %> FCFA)</span>
    <% } else { %>
      <span style="color: #28a745;">Aucun surplus</span>
    <% } %>
  </p>
  
  <p style="margin-top: 16px;"><strong>Expiration:</strong> <%= vendor.date_fin ? new Date(vendor.date_fin).toLocaleDateString('fr-FR') : '-' %></p>
  <% if (vendor.date_fin) { %>
    <% const daysLeft = Math.ceil((new Date(vendor.date_fin) - new Date()) / (1000 * 60 * 60 * 24)); %>
    <% if (daysLeft <= 5 && daysLeft > 0) { %>
      <p style="color: #ff9f40; font-weight: bold;">⚠️ Expire dans <%= daysLeft %> jours</p>
    <% } else if (daysLeft <= 0) { %>
      <p style="color: #dc3545; font-weight: bold;">🔴 Expiré</p>
    <% } %>
  <% } %>
</div>

<% if (vendor.plan === 'pro') { %>
<div class="card" style="border: 1px solid #00D4C8;">
  <h3 style="color: #00D4C8;">Configuration numéro dédié Pro</h3>
  
  <% if (!vendor.setup_status || vendor.setup_status === 'not_required') { %>
    <p style="color: #888;">Pas de configuration requise</p>
  <% } else if (vendor.setup_status === 'pending_number') { %>
    <p style="color: #ff9f40;">⏳ En attente du numéro client</p>
    <p style="color: #888; margin-top: 8px;">Le client doit envoyer son numéro WhatsApp dédié à Tracy. Attends son message.</p>
    <p><strong>Numéro reçu:</strong> <%= vendor.whatsapp_number || 'Pas encore' %></p>
  <% } else if (vendor.setup_status === 'pending_code') { %>
    <div style="background: rgba(0, 212, 200, 0.1); padding: 16px; border-radius: 8px; border: 1px solid #00D4C8;">
      <p style="color: #00D4C8; font-weight: bold;">🔑 Code de vérification reçu</p>
      <p style="margin-top: 8px;"><strong>Numéro à configurer:</strong> <%= vendor.whatsapp_number %></p>
      <p><strong>Code reçu:</strong> <span style="font-size: 28px; font-weight: bold; color: #00D4C8;"><%= vendor.meta_verification_code %></span></p>
      
      <div style="margin-top: 20px; padding: 16px; background: rgba(0, 0, 0, 0.3); border-radius: 8px;">
        <p style="font-weight: bold; margin-bottom: 12px;">Instructions pour toi :</p>
        <ol style="margin-left: 20px; line-height: 1.8;">
          <li>Va sur Meta Business Manager</li>
          <li>Ajoute le numéro <%= vendor.whatsapp_number %></li>
          <li>Entre le code <%= vendor.meta_verification_code %></li>
          <li>Clique 'Valider' sur Meta</li>
          <li>Puis clique le bouton ci-dessous</li>
        </ol>
      </div>
      
      <form method="POST" action="/clients/<%= vendor.id %>/activate-number" style="margin-top: 20px;" onsubmit="return confirm('As-tu bien validé le numéro sur Meta Business Manager ? Cette action notifiera le client.');">
        <button type="submit" class="btn btn-primary">✅ J'ai validé sur Meta — Activer le numéro</button>
      </form>
    </div>
  <% } else if (vendor.setup_status === 'active') { %>
    <p style="color: #28a745; font-weight: bold;">✅ Numéro dédié actif</p>
    <p><strong>Numéro:</strong> <%= vendor.whatsapp_number %></p>
    <p><strong>Activé le:</strong> <%= vendor.updated_at ? new Date(vendor.updated_at).toLocaleDateString('fr-FR') : '-' %></p>
  <% } %>
</div>
<% } %>

<div class="card">
  <h3>Produits (<%= products.length %>)</h3>
  <table>
    <thead>
      <tr>
        <th>Nom</th>
        <th>Prix</th>
        <th>Catégorie</th>
        <th>Statut</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(product => { %>
        <tr>
          <td><%= product.nom %></td>
          <td><%= product.prix %> FCFA</td>
          <td><%= product.categorie || '-' %></td>
          <td>
            <% if (product.statut === 'actif') { %>
              <span class="badge badge-green">Actif</span>
            <% } else { %>
              <span class="badge badge-red">Inactif</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (products.length === 0) { %>
    <p style="text-align: center; padding: 40px; color: #888;">Aucun produit</p>
  <% } %>
</div>

<div class="card">
  <h3>Actions</h3>
  <div style="display: flex; gap: 12px; flex-wrap: wrap;">
    <form method="POST" action="/clients/<%= vendor.id %>/activate">
      <button type="submit" class="btn btn-success">Activer bot</button>
    </form>
    <form method="POST" action="/clients/<%= vendor.id %>/suspend">
      <button type="submit" class="btn btn-danger">Suspendre bot</button>
    </form>
    <form method="POST" action="/clients/<%= vendor.id %>/offer-month">
      <button type="submit" class="btn btn-primary">Offrir 1 mois</button>
    </form>
  </div>
  
  <div style="margin-top: 20px;">
    <h4 style="margin-bottom: 12px;">Changer de plan</h4>
    <form method="POST" action="/clients/<%= vendor.id %>/change-plan" style="display: flex; gap: 12px; align-items: center;">
      <select name="plan">
        <option value="gratuit" <%= vendor.plan === 'gratuit' ? 'selected' : '' %>>Gratuit</option>
        <option value="starter" <%= vendor.plan === 'starter' ? 'selected' : '' %>>Starter</option>
        <option value="standard" <%= vendor.plan === 'standard' ? 'selected' : '' %>>Standard</option>
        <option value="pro" <%= vendor.plan === 'pro' ? 'selected' : '' %>>Pro</option>
      </select>
      <button type="submit" class="btn btn-primary">Changer</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
