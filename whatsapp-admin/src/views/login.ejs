<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Connexion - Tracy Admin</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #060612;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .login-card {
      background: #0D0D1F;
      padding: 48px;
      border-radius: 16px;
      border: 1px solid #1a1a2e;
      width: 100%;
      max-width: 420px;
    }
    .login-card h1 {
      margin-bottom: 8px;
      color: #00D4C8;
      font-size: 32px;
      text-align: center;
    }
    .login-card p {
      margin-bottom: 32px;
      color: #888;
      text-align: center;
      font-size: 14px;
    }
    .form-group {
      margin-bottom: 20px;
    }
    .form-group label {
      display: block;
      margin-bottom: 8px;
      color: white;
      font-size: 14px;
    }
    .form-group input {
      width: 100%;
      padding: 14px;
      border: 1px solid #1a1a2e;
      border-radius: 8px;
      font-size: 16px;
      background: #0A0A1A;
      color: white;
    }
    .form-group input:focus {
      outline: none;
      border-color: #00D4C8;
    }
    .btn {
      width: 100%;
      padding: 14px;
      background: #00D4C8;
      color: #060612;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn:hover {
      background: #00b8ac;
    }
    .error {
      background: rgba(220, 53, 69, 0.2);
      color: #dc3545;
      padding: 14px;
      border-radius: 8px;
      margin-bottom: 24px;
      border: 1px solid #dc3545;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="login-card">
    <h1>Tracy Admin</h1>
    <p>Dashboard de gestion</p>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form method="POST" action="/auth/login">
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div class="form-group">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" required>
      </div>
      <button type="submit" class="btn">Se connecter</button>
    </form>
  </div>
</body>
</html>
