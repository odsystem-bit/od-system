<%- include('partials/header', { page: 'dashboard', title: 'Vue d\'ensemble' }) %>
<h1>Vue d'ensemble</h1>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin: 30px 0;">
  <div class="card" style="background: rgba(0, 212, 200, 0.1); border: 1px solid #00D4C8;">
    <h3 style="color: #00D4C8; margin-bottom: 8px;">Clients Actifs</h3>
    <p style="font-size: 36px; color: #00D4C8; margin: 10px 0; font-weight: bold;"><%= activeCount %></p>
  </div>
  <div class="card" style="background: rgba(255, 159, 64, 0.1); border: 1px solid #ff9f40;">
    <h3 style="color: #ff9f40; margin-bottom: 8px;">Clients Suspendus</h3>
    <p style="font-size: 36px; color: #ff9f40; margin: 10px 0; font-weight: bold;"><%= suspendedCount %></p>
  </div>
  <div class="card" style="background: rgba(40, 167, 69, 0.1); border: 1px solid #28a745;">
    <h3 style="color: #28a745; margin-bottom: 8px;">Revenus du mois (FCFA)</h3>
    <p style="font-size: 36px; color: #28a745; margin: 10px 0; font-weight: bold;"><%= monthlyRevenue.toLocaleString('fr-FR') %></p>
  </div>
  <div class="card" style="background: rgba(138, 43, 226, 0.1); border: 1px solid #8a2be2;">
    <h3 style="color: #8a2be2; margin-bottom: 8px;">Conversations aujourd'hui</h3>
    <p style="font-size: 36px; color: #8a2be2; margin: 10px 0; font-weight: bold;"><%= todayConversations %></p>
  </div>
</div>

<% if (recentErrors && recentErrors.length > 0) { %>
  <div class="card" style="background: rgba(220, 53, 69, 0.2); border: 1px solid #dc3545;">
    <h3 style="color: #dc3545;">⚠️ Erreurs récentes (24h)</h3>
    <div id="alerts-container" style="margin-top: 15px;">
      <% recentErrors.forEach(error => { %>
        <div style="padding: 12px; margin-bottom: 8px; background: rgba(220, 53, 69, 0.1); border-radius: 8px; border-left: 3px solid #dc3545;">
          <strong style="color: #dc3545;">[<%= error.time %>]</strong> <span style="color: #ff9f40;"><%= error.service %></span> — <%= error.message %>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>

<div class="card">
  <h3>⏰ Cron Jobs</h3>
  <% if (cronLogs && cronLogs.length > 0) { %>
    <table style="margin-top: 16px;">
      <thead>
        <tr>
          <th>Tâche</th>
          <th>Dernier passage</th>
          <th>Statut</th>
        </tr>
      </thead>
      <tbody>
        <% cronLogs.forEach(cron => { %>
          <tr>
            <td><%= cron.task %></td>
            <td><%= cron.lastRun %></td>
            <td><span class="badge badge-green"><%= cron.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p style="color: #888;">Aucun log cron disponible</p>
  <% } %>
</div>

<div class="card">
  <h3>📊 Nouveaux clients (7 derniers jours)</h3>
  <% if (newClientsByDay && newClientsByDay.length > 0) { %>
    <div style="display: flex; align-items: flex-end; gap: 12px; height: 200px; margin-top: 20px; padding: 16px; background: rgba(0, 212, 200, 0.05); border-radius: 8px;">
      <% const maxCount = Math.max(...newClientsByDay.map(d => d.count), 1); %>
      <% newClientsByDay.forEach(day => { %>
        <div style="flex: 1; display: flex; flex-direction: column; align-items: center;">
          <div style="width: 100%; background: #00D4C8; height: <%= (day.count / maxCount) * 100 %>%; border-radius: 4px 4px 0 0; transition: height 0.3s;"></div>
          <p style="font-size: 12px; margin-top: 8px; color: #888;"><%= day.date %></p>
          <p style="font-size: 14px; font-weight: bold; color: #00D4C8;"><%= day.count %></p>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p style="color: #888;">Aucun nouveau client cette semaine</p>
  <% } %>
</div>

<script>
setInterval(async () => {
  try {
    const response = await fetch('/logs/api?level=error&limit=5');
    const logs = await response.json();
    const container = document.getElementById('alerts-container');
    
    if (logs.length === 0) {
      container.innerHTML = '<p style="color: #28a745;">✅ Aucune erreur</p>';
    } else {
      container.innerHTML = logs.map(log => `
        <div style="padding: 12px; margin-bottom: 8px; background: rgba(220, 53, 69, 0.1); border-radius: 8px; border-left: 3px solid #dc3545;">
          <strong style="color: #dc3545;">[${new Date(log.created_at).toLocaleTimeString('fr-FR')}]</strong> <span style="color: #ff9f40;">${log.service}</span> — ${log.message}
        </div>
      `).join('');
    }
  } catch (error) {
    console.error('Erreur chargement alertes:', error);
  }
}, 30000);
</script>
<%- include('partials/footer') %>
